{
  "name": "BRQ Delivery Coverage Hub",
  "description": "Aplicacao executiva para gerir e visualizar a cobertura da organizacao de Delivery da BRQ.",
  "project_type": "web_app",
  "language": "pt-BR",
  "default_agents": [
    "arquiteto",
    "domain-modeling",
    "bff-business-rules",
    "executor",
    "orquestrador-paralelo",
    "frontend",
    "crud-ux",
    "database",
    "security",
    "performance-usability",
    "ux-quality-reviewer",
    "reuse-componentization-reviewer",
    "database-performance-reviewer",
    "deploy",
    "qa",
    "observabilidade",
    "documentador"
  ],
  "entrypoints": {
    "application": "src/app/layout.tsx",
    "mock_data": "src/data/mockData.ts",
    "feature_spec": "specs/delivery-coverage-hub/requirements.md"
  },
  "canonical_root": "C:\\Users\\rmarchini\\projetos\\OrgBRQDelivery",
  "invalid_roots": [
    "C:\\Users\\rmarchini\\OneDrive - BRQ\\Documentos\\OrgBRQDelivery"
  ],
  "important_paths": [
    "docs/context-strategy.md",
    "docs/project-memory.md",
    "docs/business-rules.md",
    "docs/database.md",
    "docs/frontend.md",
    "docs/backend.md",
    "docs/api.md",
    "docs/coding-standards.md",
    "src/app",
    "src/components",
    "src/data",
    "src/lib/repositories",
    "supabase/migrations",
    "specs/delivery-coverage-hub",
    "specs/architecture-hardening",
    "docs/ARCHITECTURE.md",
    "docs/SECURITY.md",
    "docs/PRODUCTION_READINESS.md"
  ],
  "context_policy": {
    "summary_first": true,
    "read_before_source": [
      "AGENTS.md",
      ".squad/config.yaml",
      ".squad/memory.md",
      "docs/context-strategy.md",
      "docs/project-memory.md"
    ],
    "avoid_loading": [
      "node_modules",
      ".next",
      ".npm-cache",
      "coverage",
      "dist",
      "build",
      "tmp",
      "output",
      "logs",
      "screenshots",
      "videos",
      "binary spreadsheets",
      "lockfile diffs unless dependency task"
    ],
    "source_loading_rule": "Open only impacted modules after reading the relevant summary docs.",
    "agent_rule": "Invoke only relevant specialist agents and prevent duplicate repository reads."
  },
  "routines": {
    "before_change": [
      "arquiteto",
      "reuse-componentization-reviewer",
      "domain-modeling",
      "database",
      "qa"
    ],
    "after_change": [
      "ux-quality-reviewer",
      "reuse-componentization-reviewer",
      "security",
      "database-performance-reviewer",
      "qa",
      "documentador"
    ],
    "feature_or_bugfix": [
      "domain-modeling",
      "arquiteto",
      "database",
      "reuse-componentization-reviewer",
      "executor",
      "ux-quality-reviewer",
      "security",
      "database-performance-reviewer",
      "qa"
    ],
    "frontend_change": [
      "frontend",
      "crud-ux",
      "performance-usability",
      "ux-quality-reviewer",
      "reuse-componentization-reviewer",
      "qa"
    ],
    "database_change": [
      "domain-modeling",
      "database",
      "bff-business-rules",
      "security",
      "database-performance-reviewer",
      "qa",
      "documentador"
    ],
    "security_change": [
      "security",
      "database",
      "qa",
      "documentador"
    ],
    "production_change": [
      "arquiteto",
      "security",
      "performance-usability",
      "ux-quality-reviewer",
      "reuse-componentization-reviewer",
      "database-performance-reviewer",
      "deploy",
      "observabilidade",
      "qa",
      "documentador"
    ],
    "pre_deploy_quality_gate": [
      "qa",
      "security",
      "performance-usability",
      "ux-quality-reviewer",
      "reuse-componentization-reviewer",
      "database-performance-reviewer",
      "deploy",
      "documentador"
    ],
    "post_deploy_smoke": [
      "observabilidade",
      "performance-usability",
      "qa"
    ],
    "new_project_bootstrap": [
      "arquiteto",
      "domain-modeling",
      "executor",
      "orquestrador-paralelo",
      "frontend",
      "crud-ux",
      "database",
      "bff-business-rules",
      "security",
      "performance-usability",
      "ux-quality-reviewer",
      "reuse-componentization-reviewer",
      "database-performance-reviewer",
      "deploy",
      "qa",
      "observabilidade",
      "documentador"
    ]
    ,
    "large_audit_or_refactor": [
      "orquestrador-paralelo",
      "domain-modeling",
      "database",
      "bff-business-rules",
      "frontend",
      "crud-ux",
      "security",
      "performance-usability",
      "ux-quality-reviewer",
      "reuse-componentization-reviewer",
      "database-performance-reviewer",
      "deploy",
      "qa",
      "documentador"
    ]
  },
  "evolution_policy": {
    "record_learning_in": ".codex/learning-log.md",
    "record_decisions_in": ".codex/decisions.md",
    "promote_learning_to_agent_when": "A regra se repetir, prevenir falha real ou virar padrao confirmado pelo usuario.",
    "do_not_silently_rewrite_agents": true
  }
}

