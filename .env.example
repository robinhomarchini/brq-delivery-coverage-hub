NEXT_PUBLIC_DATA_PROVIDER=supabase
NEXT_PUBLIC_AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-side AI provider for Analise de Desafio.
# Keep OPENAI_API_KEY only in Vercel project env or local ignored env files.
OPENAI_API_KEY=
AI_MODEL=gpt-5.5
AI_MAX_TOKENS=900
AI_TEMPERATURE=0.2

# SECURITY: SUPABASE_SERVICE_ROLE_KEY must NEVER be committed or exposed in frontend.
# This key is ONLY for local scripts and server-side operations.
# Set it ONLY in .env.local (never in .env, .env.production, or version control).
# RLS_SMOKE_PROVISION_CONFIRM is also sensitive and should be in .env.local only.
# VERCEL_TOKEN is also sensitive and should be in .env.production.local or
# .env.local only if local deploy is needed without Vercel device-login/auth.json.
#
# Example .env.local names (never commit values):
# - Supabase service role key for local maintenance scripts only.
# - RLS smoke provisioning confirmation token.
# - Vercel deploy token for local CLI publishing.

# Optional RLS smoke users. Use dedicated test accounts only.
SUPABASE_RLS_VIEWER_EMAIL=
SUPABASE_RLS_VIEWER_PASSWORD=
SUPABASE_RLS_EDITOR_EMAIL=
SUPABASE_RLS_EDITOR_PASSWORD=
SUPABASE_RLS_ADMIN_EMAIL=
SUPABASE_RLS_ADMIN_PASSWORD=
SUPABASE_RLS_BLOCKED_EMAIL=
SUPABASE_RLS_BLOCKED_PASSWORD=
